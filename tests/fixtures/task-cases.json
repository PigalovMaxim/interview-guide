    "check": "let time=0;const q=createDeliveryQueue([{id:\"a\",value:1},{id:\"b\",value:2}],()=>time);const a=q.take(10),b=q.take(10);assert.equal(q.take(1),null);assert.equal(q.size(),2);time=10;assert.equal(q.ack(a.receipt),false);const again=q.take(5);assert.equal(again.id,\"a\");assert.notEqual(again.receipt,a.receipt);assert.equal(q.nack(again.receipt),true);const third=q.take(5);assert.equal(q.ack(again.receipt),false);assert.equal(q.ack(third.receipt),true);assert.equal(q.size(),1);assert.equal(q.take(1).id,\"b\");"
