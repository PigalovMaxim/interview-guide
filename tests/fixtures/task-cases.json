    "id": "v2:coding:reusable-barrier",
    "check": "const b=createBarrier(2);const a=b.wait(),c=b.wait();assert.deepEqual(await Promise.all([a,c]),[0,1]);const d=b.wait(),reason={stop:true};const failure=assert.rejects(d,error=>error===reason);b.break(reason);await failure;assert.deepEqual(await Promise.all([b.wait(),b.wait()]),[0,1]);b.break(\"nothing\");assert.equal(await createBarrier(1).wait(),0);"
