  },
  {
    "id": "v2:coding:deadline-wrapper",
    "check": "let fire,clears=0,signal,rejectOperation;const scheduler={set(fn){fire=fn;return 1;},clear(id){assert.equal(id,1);clears++;}};const p=withDeadline(s=>{signal=s;return new Promise((_,r)=>rejectOperation=r);},5,scheduler);const failed=assert.rejects(p,/Timeout/);await Promise.resolve();fire();await failed;assert.equal(signal.aborted,true);rejectOperation(new Error(\"late\"));await Promise.resolve();await Promise.resolve();assert.equal(clears,1);clears=0;assert.equal(await withDeadline(()=>7,5,scheduler),7);fire();assert.equal(clears,1);clears=0;await assert.rejects(withDeadline(()=>{throw new Error(\"sync\");},5,scheduler),/sync/);assert.equal(clears,1);"
  },
  {
    "id": "v2:coding:abort-group",
    "check": "const parent=new AbortController(),g=createAbortGroup(parent.signal),a=g.fork(),b=g.fork();b.close();let nested;a.signal.addEventListener(\"abort\",()=>nested=g.fork());const reason={x:1};parent.abort(reason);assert.equal(a.signal.reason,reason);assert.equal(b.signal.aborted,false);assert.equal(nested.signal.reason,reason);assert.equal(g.fork().signal.reason,reason);g.close();const p2=new AbortController();p2.abort(\"done\");assert.equal(createAbortGroup(p2.signal).fork().signal.reason,\"done\");const g2=createAbortGroup(new AbortController().signal);g2.close();assert.equal(g2.fork().signal.reason.message,\"Group closed\");"
  },
